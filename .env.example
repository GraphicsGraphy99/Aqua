# Public values may be exposed to the browser. Never put service-role keys here.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# SERVER-ONLY: required for the restricted contact-message insert endpoint. Never use NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY

# Server-only. Generate a random value; never prefix with NEXT_PUBLIC_.
CONTACT_RATE_LIMIT_SECRET=replace-with-a-long-random-secret
# Optional transactional email provider, if you add an email adapter:
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
